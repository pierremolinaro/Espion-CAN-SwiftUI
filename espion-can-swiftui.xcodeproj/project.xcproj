{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/pierremolinaro/Swift-Package-Pico-Connection",
      "version": {
        "version-range": "1.0.0..<2.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/sparkle-project/Sparkle",
      "version": {
        "up-to-next-major-version": "2.10.0",
      },
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "espion-can-swiftui",
      "target-membership": [
        "espion-can-swiftui",
      ],
      "membership-exceptions": [
        {
          "target": "espion-can-swiftui",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/espion-can-swiftui.app", "id": "CF9F89802E966F7D00F49B4E", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "espion-can-swiftui",
      "id": "CF9F897F2E966F7D00F49B4E",
      "product": "Products/espion-can-swiftui.app",
      "product-type": "application",
      "last-swift-migration": "26.1",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "Sparkle",
          "product-name": "Sparkle",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Swift-Package-Pico-Connection",
          "product-name": "PicoConnection",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS": "NO",
        "CLANG_ENABLE_MODULES": "YES",
        "CODE_SIGN_IDENTITY[sdk=macosx*]": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "DEAD_CODE_STRIPPING": "YES",
        "DEVELOPMENT_TEAM": "YW8QY74J2A",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "espion-can-swiftui/Info.plist",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.developer-tools",
        "INFOPLIST_KEY_NSLocalNetworkUsageDescription": "Découverte des services réseau locaux",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "15.6",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "name.pcmolinaro.pierre.espion-can-swiftui",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
